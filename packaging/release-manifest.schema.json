{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "E-Waste Triage release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "app_version", "model", "components", "target", "created_at", "parity"],
  "properties": {
    "schema_version": {"const": 1},
    "app_version": {"type": "string", "minLength": 1},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "artifact_sha256", "manifest_sha256", "labels_sha256", "schema_version"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "labels_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema_version": {"const": 1}
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "schema_version", "version"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema_version": {"const": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture", "minimum_macos"],
      "properties": {
        "architecture": {"const": "arm64"},
        "minimum_macos": {"const": "14.0"}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "status", "model_id", "model_sha256", "labels", "metrics", "holdout"],
      "properties": {
        "schema_version": {"const": 1},
        "status": {"const": "passed"},
        "model_id": {"type": "string", "minLength": 1},
        "model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "labels": {
          "const": [
            "0301_computer_mouse",
            "0301_keyboard",
            "0303_laptop",
            "0306_mobile_phone",
            "0401_headphones"
          ]
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference_images", "top1_matches", "max_probability_delta"],
          "properties": {
            "reference_images": {"type": "integer", "minimum": 1},
            "top1_matches": {"type": "integer", "minimum": 0},
            "max_probability_delta": {"type": "number", "minimum": 0, "maximum": 0.0001}
          }
        },
        "holdout": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "split", "valid", "overlaps_training", "samples"],
          "properties": {
            "status": {"const": "passed"},
            "split": {"const": "holdout"},
            "valid": {"const": true},
            "overlaps_training": {"const": false},
            "samples": {"type": "integer", "minimum": 1}
          }
        }
      }
    }
  }
}
